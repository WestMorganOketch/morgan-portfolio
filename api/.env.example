NODE_ENV=development
PORT=3001
# In Render, include the exact production Vercel origin in this allow-list.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=
ADMIN_EMAIL=admin@example.com
SESSION_SECRET=
# Optional. Generate a scrypt hash with: npm run admin:password-hash
ADMIN_PASSWORD_HASH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/auth/google/callback
FRONTEND_URL=http://localhost:3000
DB_SSL=true
DB_SSL_CA_PATH=
DB_SSL_CA=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENT_BUCKET=portfolio-documents
