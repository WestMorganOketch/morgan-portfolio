NODE_ENV=development
PORT=3001
# In Render, include the exact production Vercel origin in this allow-list.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=
DB_SSL=true
DB_SSL_CA_PATH=
DB_SSL_CA=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENT_BUCKET=portfolio-documents
ADMIN_CLAIM_ENABLED=false
JOB_CRON_SECRET=
DOC_ENCRYPTION_KEY=
# Private bucket for AES-256-GCM encrypted Career Radar documents; separate from portfolio files.
CAREER_DOCUMENT_BUCKET=career-private-documents
# Optional address restriction; must match the Google account connected below.
GMAIL_USER=
# Google OAuth web-client settings; redirect URI must exactly match the registered API callback.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=
# Reserved for sources not enabled by this version of Job Radar; these are not active search providers.
GEMINI_API_KEY=
JOOBLE_API_KEY=
CAREERJET_API_KEY=
RELIEFWEB_APPNAME=
JR_SEND_MODE=draft
